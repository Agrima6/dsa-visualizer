# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ElevenLabs (text-to-speech proxy in app/api/tts/route.ts)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Pre-launch access gate — single shared password (lib/gate-cookie.ts).
GATE_PASSWORD=

# Upstash Redis — free database at upstash.com, used to store pre-registered
# emails (lib/redis.ts, lib/preregister.ts). From your database's page:
# Details -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated emails allowed onto /superadmin (lib/admin.ts). Easiest way
# to bootstrap your own admin access without touching the Clerk dashboard —
# just put your own Clerk account's email here.
ADMIN_EMAILS=

# Razorpay — from Dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Razorpay webhook secret — from Dashboard -> Settings -> Webhooks, when you
# register https://<your-domain>/api/payment/webhook subscribed to
# "payment.captured". Required by app/api/payment/webhook/route.ts.
RAZORPAY_WEBHOOK_SECRET=

# Sentry error monitoring — create a project at sentry.io, Settings ->
# Client Keys (DSN). Both server and client configs are inert (Sentry.init
# silently no-ops) until this is set, so it's safe to leave blank in dev.
# NEXT_PUBLIC_SENTRY_DSN and SENTRY_DSN are usually the same value — set
# both. SENTRY_AUTH_TOKEN/SENTRY_ORG/SENTRY_PROJECT are only needed to
# upload source maps on deploy (Settings -> Auth Tokens); without them the
# build still works, you just get minified stack traces in Sentry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog product analytics — create a project at posthog.com (or your
# self-hosted instance), Project Settings -> API keys. Also inert until
# set (lib/posthog-provider.tsx checks for this before initializing).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
